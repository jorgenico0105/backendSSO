# --- Servidor ---
PORT=3000
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# --- Base de datos local (MySQL 8) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=TuNuevaPassword123!
DB_NAME=sst_prevencion
# true = TypeORM crea/actualiza las tablas al arrancar (solo desarrollo local).
# Para producción pon false y usa migraciones (npm run migration:generate / migration:run).
DB_SYNC=true

# --- OpenAI (agente SST) ---
OPENAI_API_KEY=
# Modelo con visión para imágenes, video (frames) y extracción NTP 330.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sst-prevencion

# --- Evaluación ergonómica (servicio de análisis postural, ../ergonomic-poses) ---
# La pose y los puntajes RULA/REBA/OWAS los mide el servicio Python; aquí no se usa IA.
ERGO_API_URL=http://localhost:8000
# Deben coincidir con API_KEY y WEBHOOK_SECRET del .env de ergonomic-poses.
ERGO_API_KEY=
ERGO_WEBHOOK_SECRET=
# URL de este backend a la que el servicio avisa cuando termina un video.
ERGO_CALLBACK_URL=http://localhost:3000/api/ergo/webhook

# --- Super administrador inicial (se crea al arrancar si no existe) ---
SEED_ADMIN_EMAIL=admin@sstprevencion.com
SEED_ADMIN_PASSWORD=1

# --- Datos legales (páginas /terminos, /privacidad, /soporte, /eliminar-cuenta) ---
# Quién ofrece el servicio y el correo de soporte/privacidad. App Store y Google Play los exigen.
LEGAL_TITULAR=SST Prevención
LEGAL_IDENTIFICACION=
LEGAL_EMAIL=
LEGAL_CIUDAD=Loja, Ecuador
